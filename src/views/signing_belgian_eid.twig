<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ __('Signing document') }}</title>
    <link rel="stylesheet" href="{{ BASE_URL }}/node_modules/@fortawesome/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="{{ BASE_URL }}/node_modules/bootstrap/dist/css/bootstrap.min.css">
    <script>
        const SIGNING = {
            jobId: {{ jobId|json_encode|raw }},
        };
    </script>
    <script type="module"
            src="{{ BASE_URL }}/vendor/tigress/belgian-eid/public/javascript/belgian_eid_signer.js"></script>
</head>
<body class="bg-light">
<div class="container-fluid py-3">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>{{ __('Signing document') }}</strong>
                </div>
                <div class="card-body">
                    <p>{{ __('Check the document below before digitally signing it with your Belgian eID.') }}</p>
                    <iframe src="{{ pdfUrl }}"
                            style="width: 100%; height: calc(100vh - 220px); border: 1px solid #dee2e6;"
                            title="{{ __('Document to be signed') }}"></iframe>
                </div>
                <div class="card-footer text-end">
                    <a href="{{ cancelUrl }}" class="btn btn-danger"><i
                                class="fa-solid fa-xmark"></i> {{ __('Cancel') }}</a>
                    <button type="button" class="btn btn-primary" id="btnSign"><i
                                class="fa-solid fa-file-signature"></i> {{ __('Sign with eID') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>